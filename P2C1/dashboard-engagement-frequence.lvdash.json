{
  "datasets": [
    {
      "name": "ds_genres",
      "displayName": "freq_top_genres",
      "queryLines": [
        "-- Top genres, au grain jour x offre x genre pour que les filtres agissent\n",
        "SELECT DATE(e.horodatage) AS jour, a.offre, e.genre, COUNT(*) AS nb_ecoutes\n",
        "FROM frequence.socle.ecoutes_enrichies e\n",
        "JOIN frequence.socle.abonnements a\n",
        "  ON  e.id_utilisateur = a.id_utilisateur\n",
        "  AND e.horodatage >= a.date_debut\n",
        "  AND e.horodatage <  COALESCE(a.date_fin, CURRENT_TIMESTAMP())\n",
        "GROUP BY ALL"
      ]
    },
    {
      "name": "ds_heures",
      "displayName": "freq_heures_ecoute",
      "queryLines": [
        "-- Heures d'écoute, au grain jour x heure x offre\n",
        "SELECT DATE(e.horodatage) AS jour, HOUR(e.horodatage) AS heure, a.offre, COUNT(*) AS nb_ecoutes\n",
        "FROM frequence.socle.ecoutes e\n",
        "JOIN frequence.socle.abonnements a\n",
        "  ON  e.id_utilisateur = a.id_utilisateur\n",
        "  AND e.horodatage >= a.date_debut\n",
        "  AND e.horodatage <  COALESCE(a.date_fin, CURRENT_TIMESTAMP())\n",
        "GROUP BY ALL"
      ]
    },
    {
      "name": "ds_ecart",
      "displayName": "ecart_offres",
      "queryLines": [
        "-- Écart entre offres (jointure datée de P1C4), au grain jour x offre x abonné\n",
        "SELECT DATE(e.horodatage) AS jour, a.offre, e.id_utilisateur,\n",
        "       SUM(e.duree_ecoutee) AS duree_ecoutee, COUNT(*) AS nb_ecoutes\n",
        "FROM frequence.socle.ecoutes e\n",
        "JOIN frequence.socle.abonnements a\n",
        "  ON  e.id_utilisateur = a.id_utilisateur\n",
        "  AND e.horodatage >= a.date_debut\n",
        "  AND e.horodatage <  COALESCE(a.date_fin, CURRENT_TIMESTAMP())\n",
        "GROUP BY ALL"
      ],
      "columns": [
        {
          "displayName": "heures_gratuit",
          "description": "Heures d'écoute par abonné gratuit ayant écouté",
          "expression": "ROUND(SUM(CASE WHEN offre = 'gratuit' THEN duree_ecoutee END) / 3600.0 / COUNT(DISTINCT CASE WHEN offre = 'gratuit' THEN id_utilisateur END), 1)"
        },
        {
          "displayName": "heures_premium",
          "description": "Heures d'écoute par abonné premium ayant écouté",
          "expression": "ROUND(SUM(CASE WHEN offre = 'premium' THEN duree_ecoutee END) / 3600.0 / COUNT(DISTINCT CASE WHEN offre = 'premium' THEN id_utilisateur END), 1)"
        },
        {
          "displayName": "minutes_par_abonne",
          "description": "Durée totale écoutée / abonnés distincts ayant écouté, en minutes",
          "expression": "ROUND(SUM(duree_ecoutee) / 60.0 / COUNT(DISTINCT id_utilisateur), 0)"
        }
      ]
    }
  ],
